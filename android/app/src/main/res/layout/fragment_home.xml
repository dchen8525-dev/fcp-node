<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <!-- ===== 顶栏：品牌 + 设置 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo"
                android:padding="6dp"
                android:src="@drawable/ic_shield_white"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/fcp_brand"
                android:textColor="@color/fcp_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/fcp_btn_settings"
                app:icon="@drawable/ic_settings"
                app:iconTint="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <!-- ===== 状态英雄卡 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fcp_card"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <!-- 状态行：色点 + 文案 + 连接中进度 + 模式徽章 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/status_dot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/bg_status_dot_disconnected"
                                android:importantForAccessibility="no"/>

                            <TextView
                                android:id="@+id/status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:text="@string/fcp_state_unconfigured"
                                android:textColor="@color/fcp_text_primary"
                                android:textSize="21sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.01"/>

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progress_ring"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorSize="16dp"
                                app:trackThickness="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/server_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="-0.01"
                            android:text="@string/fcp_server_unconfigured"
                            android:textColor="@color/fcp_text_muted"
                            android:textSize="11.5sp"
                            tools:text="144.34.186.164:4461"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/mode_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mode_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/fcp_mode_vpn"
                        android:textColor="@color/fcp_badge_text"
                        android:textSize="10.5sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 大号下行速率：本屏唯一的视觉焦点 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/fcp_rate_down_label"
                    android:textColor="@color/fcp_text_faint"
                    android:textSize="11sp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/chip_down_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="-0.025"
                        android:text="—"
                        android:textColor="@color/fcp_text_primary"
                        android:textSize="42sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/rate_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="7dp"
                        android:text="@string/fcp_unit_mb_s"
                        android:textColor="@color/fcp_text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 分隔线 + 三列指标 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/fcp_divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fcp_metric_up"
                            android:textColor="@color/fcp_text_faint"
                            android:textSize="10.5sp"/>

                        <TextView
                            android:id="@+id/chip_up_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textColor="@color/fcp_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fcp_chip_sessions"
                            android:textColor="@color/fcp_text_faint"
                            android:textSize="10.5sp"/>

                        <TextView
                            android:id="@+id/chip_sessions_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textColor="@color/fcp_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fcp_chip_duration"
                            android:textColor="@color/fcp_text_faint"
                            android:textSize="10.5sp"/>

                        <TextView
                            android:id="@+id/chip_duration_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textColor="@color/fcp_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 主按钮：连接 / 断开 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_main"
                    style="@style/Widget.FcpVpn.Button.PrimaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/fcp_connect"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 按应用代理入口 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vpn_apps_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fcp_card"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fcp_label_vpn_apps"
                        android:textColor="@color/fcp_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/vpn_apps_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/fcp_apps_all"
                        android:textColor="@color/fcp_text_faint"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_gray"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 把提示与日志推到底部：内容少时页面也不会在卡片下方留一大片空白 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="18dp"/>

        <!-- 代理端口提示 -->
        <TextView
            android:id="@+id/proxy_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/fcp_text_faint"
            android:textSize="11sp"
            tools:text="混合代理 127.0.0.1:1080"/>

        <!-- 底部：日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_log"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/fcp_btn_log"
                android:textColor="@color/fcp_text_muted"
                android:textSize="12.5sp"
                app:icon="@drawable/ic_terminal"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/fcp_text_muted"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
