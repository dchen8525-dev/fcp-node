{
  "name": "fcp-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "FCP v7 tunnel desktop shell (Electron) - drives the Node tunnel port",
  "main": "electron/main.cjs",
  "scripts": {
    "build:tunnel": "node scripts/build-tunnel.mjs",
    "start": "node scripts/build-tunnel.mjs && electron .",
    "pack": "node scripts/build-tunnel.mjs && electron-builder --win --x64 --publish never",
    "pack:portable": "node scripts/build-tunnel.mjs && electron-builder --win portable --x64 --publish never",
    "pack:nsis": "node scripts/build-tunnel.mjs && electron-builder --win nsis --x64 --publish never",
    "pack:dir": "node scripts/build-tunnel.mjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.fcp.desktop",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "productName": "FCP Node",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "FCP-Node-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "FCP-Node-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FCP Node",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum"
  }
}
