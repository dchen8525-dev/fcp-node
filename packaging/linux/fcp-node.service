[Unit]
Description=FCP Node UDP tunnel server
Documentation=https://github.com/dchen8525-dev/fcp-node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fcp-node
Group=fcp-node
EnvironmentFile=/etc/fcp-node/server.conf
ExecStart=/usr/bin/fcp-server
Restart=always
RestartSec=2
LimitNOFILE=1048576
LogsDirectory=fcp-node
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
