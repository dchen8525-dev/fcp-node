#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
  if getent passwd fcp-node >/dev/null 2>&1; then
    userdel fcp-node >/dev/null 2>&1 || true
  fi
  if getent group fcp-node >/dev/null 2>&1; then
    groupdel fcp-node >/dev/null 2>&1 || true
  fi
  rm -rf /var/log/fcp-node /var/lib/fcp-node
  # dpkg has already removed the conffile; drop the directory only if empty.
  rmdir /etc/fcp-node >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
